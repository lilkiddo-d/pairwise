# Which network the app talks to: "mainnet" (Robinhood Chain 4663) or "fork" (local anvil, chain id 31337)
NEXT_PUBLIC_NETWORK=mainnet
# Optional custom RPC (defaults to the public RPC from config/robinhood-mainnet.json)
NEXT_PUBLIC_RPC_URL=
# WalletConnect Cloud project id (optional: without it only injected wallets are offered)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# $PAIR project token address. EMPTY = every token feature (staking, proposals) is hidden.
NEXT_PUBLIC_PROJECT_TOKEN=
# Optional geoblock: comma-separated ISO-3166 alpha-2 country codes (uses Vercel's x-vercel-ip-country header)
NEXT_PUBLIC_GEOBLOCK_COUNTRIES=
