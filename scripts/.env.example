# "mainnet" (Robinhood Chain 4663) or "fork" (local anvil, chain id 31337)
KEEPER_NETWORK=mainnet
# RPC (defaults to the public RPC; use a dedicated provider in production)
KEEPER_RPC_URL=
# Foundry keystore account used to sign (created with: cast wallet import pairwise-keeper --interactive)
KEEPER_ACCOUNT=pairwise-keeper
# Optional: file containing the keystore password so the daemon can sign unattended (chmod 600 it).
# If unset, cast prompts for the password on every transaction.
KEEPER_PASSWORD_FILE=
# Local fork only: sign with anvil's unlocked account instead of a keystore
KEEPER_UNLOCKED_FROM=
# Loop interval in seconds
KEEPER_INTERVAL=60
# Also harvest protocol fees (permissionless) once a day
KEEPER_HARVEST=false
# Print transactions instead of sending them
KEEPER_DRY_RUN=false
